{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug algorithm_test",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}/build/algorithm_test",

            "args": [],

            "stopAtEntry": false,

            "cwd": "${workspaceFolder}",

            "environment": [],

            "externalConsole": false,

            "MIMode": "gdb",

            "miDebuggerPath": "/usr/bin/gdb",

            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],

            "preLaunchTask": "CMake Build"
        }
    ]
}